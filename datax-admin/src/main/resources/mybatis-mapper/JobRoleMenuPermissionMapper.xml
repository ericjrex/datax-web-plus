<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wugui.datax.admin.mapper.JobRoleMenuPermissionMapper">

    <resultMap id="BaseResultMap" type="com.wugui.datax.admin.entity.JobRoleMenuPermission">
        <id column="id" property="id" />
        <result column="role_code" property="roleCode" />
        <result column="menu_codes" property="menuCodes" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, role_code, menu_codes, create_time, update_time
    </sql>

    <!-- 根据角色编码查询 -->
    <select id="getByRoleCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM job_role_menu_permission
        WHERE role_code = #{roleCode}
        LIMIT 1
    </select>

    <!-- 查询所有角色菜单授权策略 -->
    <select id="listAllRoleMenus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM job_role_menu_permission
        ORDER BY id DESC
    </select>

</mapper>
