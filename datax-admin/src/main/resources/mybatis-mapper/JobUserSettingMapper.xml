<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wugui.datax.admin.mapper.JobUserSettingMapper">

    <resultMap id="BaseResultMap" type="com.wugui.datax.admin.entity.JobUserSetting">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="setting_key" property="settingKey"/>
        <result column="setting_value" property="settingValue"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, username, setting_key, setting_value, create_time, update_time
    </sql>

    <!-- 根据用户ID与配置键获取单项配置 -->
    <select id="getByUserIdAndKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM job_user_setting
        WHERE user_id = #{userId} AND setting_key = #{settingKey}
        LIMIT 1
    </select>

    <!-- 插入或更新用户配置 (MySQL ON DUPLICATE KEY UPDATE) -->
    <insert id="saveOrUpdateSetting" parameterType="com.wugui.datax.admin.entity.JobUserSetting" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_user_setting (user_id, username, setting_key, setting_value, create_time, update_time)
        VALUES (#{userId}, #{username}, #{settingKey}, #{settingValue}, NOW(), NOW())
        ON DUPLICATE KEY UPDATE
            username = VALUES(username),
            setting_value = VALUES(setting_value),
            update_time = NOW()
    </insert>

</mapper>
